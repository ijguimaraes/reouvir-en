# Banco (dev: Postgres do docker compose; o dbmate lê esta variável)
DATABASE_URL=postgres://reouvir:reouvir@localhost:5432/reouvir?sslmode=disable
# Banco usado pelos testes de integração (migre-o com DATABASE_URL apontando para ele)
DATABASE_URL_TEST=postgres://reouvir:reouvir@localhost:5432/reouvir_test?sslmode=disable
POSTGRES_USER=reouvir
POSTGRES_PASSWORD=reouvir
POSTGRES_DB=reouvir

# API
PORT=3711
# Porta do Caddy no host (o `tailscale serve` aponta para ela)
CADDY_PORT=8080
# Mínimo de 32 caracteres. Gere com: openssl rand -base64 48
SESSION_SECRET=troque-este-segredo-por-um-valor-aleatorio-longo
# false apenas em desenvolvimento por HTTP; em produção (HTTPS) deixe true
COOKIE_SECURE=false

# Administrador inicial (pnpm seed:admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=troque-esta-senha

# Fases futuras
ELEVENLABS_API_KEY=
# Voz e modelo: trocar invalida o reaproveitamento dos áudios já gerados
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
AUDIO_DIR=./audio-data

# Tradução das frases para português (botão "Traduzir pendentes" no backoffice e tool translate_playlist do MCP).
# Sem a chave, tudo funciona; só a geração automática responde 503. A tradução também pode vir junto da frase.
ANTHROPIC_API_KEY=
# TRANSLATION_MODEL=claude-haiku-5-5
