# Origem única por caminho. O HTTPS fica a cargo do `tailscale serve`, na frente deste Caddy.
{
	auto_https off
	admin off
}

:80 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:3711
	}

	# Os MP3 têm o hash do conteúdo no nome: nunca mudam, cache longo.
	handle /audio/* {
		uri strip_prefix /audio
		root * /srv/audio
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /admin* {
		uri strip_prefix /admin
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}

	handle {
		root * /srv/web
		@shell path /sw.js /index.html /manifest.webmanifest
		header @shell Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
